# =============================================================================
# .env.example —— 复制为 .env 后填写。.env 已被 .gitignore 排除。
# 缺失的项 = 该能力未启用，系统不会假装可用。
# =============================================================================

# ---------- 1. 星财富 OpenAPI 凭证（必须由开放平台下发） ----------
# 网关 base_url，不含末尾 '/'
FSOPENAPI_BASE_URL=
# 开放平台下发的 API Key
FSOPENAPI_API_KEY=
# 服务端长期公钥（PEM）。可多行，建议用保险箱管理，此处仅作本地调试后备
FSOPENAPI_SERVER_PUBLIC_KEY=
# 客户端长期私钥（PEM）
FSOPENAPI_CLIENT_PRIVATE_KEY=
# 接口前缀："ops" 走 /api/ops ，留空走 /api
SDK_TYPE=ops
# 响应语言：zhCn | zhTc | en
FSOPENAPI_LANG=zhCn
# 是否校验服务端 HTTPS 证书，生产环境必须为 true
FSOPENAPI_CLIENT_SSL_VERIFY=true

# 交易子账户 / 代理账户（OPS 场景 apply_account_id 必填）
FOSUN_SUB_ACCOUNT_ID=
FOSUN_APPLY_ACCOUNT_ID=

# ---------- 2. AI 模型 ----------
# 仅兼容 OpenAI Chat Completions 协议的端点
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---------- 3. 安全开关（默认全部关闭真实交易） ----------
LIVE_TRADING=false
ORDER_EXECUTION_ENABLED=false
PAPER_TRADING=true
KILL_SWITCH=false
# 开启真实交易必须同时把此变量设为：I UNDERSTAND REAL MONEY IS AT RISK
LIVE_ACK_PHRASE=

# ---------- 4. Web 管理界面 ----------
WEB_HOST=127.0.0.1
WEB_PORT=8781
WEB_SESSION_SECRET=
WEB_ADMIN_PASSWORD=

# ---------- 5. 密钥保险箱主口令 ----------
# 用于 DPAPI 之外的一层包装；仅在跨机器迁移导出时使用
VAULT_PASSPHRASE=
